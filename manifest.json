{
  "manifest_version": 3,
  "name": "Drive Quick Link",
  "version": "0.1",
  "description": "Copy Google Drive item links in one click.",
  "permissions": ["clipboardWrite"],
  "host_permissions": ["https://drive.google.com/*"],
  "content_scripts": [{
    "matches": ["https://drive.google.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png", 
    "48": "icons/48.png"
  }
}